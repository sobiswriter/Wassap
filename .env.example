# Google Gemini API Key
GEMINI_API_KEY=

# Optional Google Cloud / Vertex AI Credentials
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_KEY=

# Optional shared cloud passkey. Blank keeps the existing member passkey.
VERTEX_PASSCODE=
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Never prefix shared credentials with VITE_: VITE_ variables are public.
